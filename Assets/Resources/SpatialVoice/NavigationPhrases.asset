  version: signed-navigation-v2-semantic
  phrases:
  - id: nav_a00_d0_direct
    text: Turn left toward the back.
    minAngle: -180
    maxAngle: -150
    minDistance: 0
    maxDistance: 1
    tone: 0
    metadata:
      intent: turn
      horizontal: left
      vertical: none
      magnitude: large
      stage: outside_target_wall
      interruptPolicy: replace_if_misleading
      requires:
      - fresh_valid_gaze
      - matching_angle_and_distance
      - prepared_voice_clip
      canBeSupersededBy:
      - target_wall_reached
      - target_acquired
      - direction_reversed
